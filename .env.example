# ============================================================
#  MT5 DCA Forex Bot — Environment Configuration
# ============================================================

# --- MT5 Exness Account Credentials ---
MT5_LOGIN=12345678
MT5_PASS=YourPasswordHere
MT5_SERVER=Exness-MT5Trial7

# --- Trading Symbol ---
# Use the exact Exness symbol name (check Market Watch for suffix)
SYMBOL=EURUSDm

# --- Timeframe ---
# Options: M1, M5, M15, M30, H1, H4, D1
TIMEFRAME=M5

# --- Entry Lot Size (Initial Order) ---
INITIAL_LOT=0.01

# --- DCA Settings ---
# Step distance in pips before opening a new DCA order
STEP_DISTANCE_PIPS=20

# Lot multiplier for each subsequent DCA order (e.g., 1.5 = Martingale-lite)
LOT_MULTIPLIER=1.5

# Maximum number of DCA orders (including the initial order)
MAX_ORDERS=6

# --- Basket Close (Global Exit) ---
# Target profit in account currency (USD) to close the entire basket
TARGET_PROFIT_USD=5.0

# --- Safety: Global Stop Loss ---
# Maximum drawdown percentage from session start equity before emergency close
MAX_DRAWDOWN_PCT=10.0

# --- Trading Hours (Server Time / UTC) ---
# Bot will only enter NEW trades within this window (HH:MM format)
TRADING_START_HOUR=08:00
TRADING_END_HOUR=20:00

# --- Magic Number ---
# Unique identifier to tag all orders from this bot instance
MAGIC_NUMBER=550055
