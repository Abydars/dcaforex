# ============================================================
#  DCA Forex Bot — Configuration
# ============================================================

# --- MT5 Exness Account Credentials ---
MT5_LOGIN=12345678
MT5_PASS=YourPasswordHere
MT5_SERVER=Exness-MT5Trial7

# --- What to trade ---
SYMBOLS=EURUSDm,XAUUSDm,GBPUSDm,USDJPYm,USOILm,UKOILm,USDCHFm,XAGUSDm,AUDUSDm,US30m,USDCADm,BTCUSDm

# --- Timeframe for entry signals ---
TIMEFRAME=M5

# --- Signal Mode ---
# "candle"  = green candle = BUY, red = SELL (fast, for DCA)
# "pattern" = only Engulfing/Hammer patterns (selective)
SIGNAL_MODE=candle

# --- Maximum Consecutive Pairs ---
# Set the maximum number of symbols the bot can trade at the exact same time
MAX_OPEN_SYMBOLS=2

# Wait for candle to settle across all symbols
SYNC_DELAY_SECONDS=3.0



# --- Magic Number (unique bot ID) ---
MAGIC_NUMBER=550055

# --- Dashboard Security ---
DASHBOARD_PASSWORD=admin@123

